# Names only. Put real values in your agent platform's secret store or the process env.
# Never commit a filled-in copy of this file.

GITHUB_TOKEN=            # repo read; write only for repos you allow (profile README, portfolio)
TODOIST_API_TOKEN=       # task manager (or swap for your own, see integrations.md)
GOOGLE_OAUTH_CREDENTIALS= # resume doc read/suggest (path or JSON, platform-specific)
SUPABASE_ACCESS_TOKEN=   # portfolio/team-page CMS, if it is Supabase (or COMPOSIO_API_KEY below)
COMPOSIO_API_KEY=        # optional: one gateway for LinkedIn read, Supabase, etc.
FIGMA_ACCESS_TOKEN=      # optional: mind map in FigJam
LINKEDIN_ACCESS_TOKEN=   # optional: read-only profile
COACH_TIMEZONE=          # e.g. Europe/Berlin
COACH_LANGUAGE=          # e.g. en, fa, de
